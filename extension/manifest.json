{
    "manifest_version": 3,
    "name": "CFF: Control for Freedom",
    "version": "1.0",

    "description": "Conscious limits for digital freedom",

    "icons": {
        "48": "FF-extension-refactored/extension/icons/extnsn_icon.png",
        "96": "FF-extension-refactored/extension/icons/extnsn_icon96.png"
    },

    "browser_specific_settings": {
        "gecko": {
            "id": "",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "content_scripts": [
        {
            "matches": ["*://*.mozilla.org/*"],
            "js": ["content/content.js"]
        }
    ]
}

